{
  "name": "dev-snapshot",
  "displayName": "AmberTrail",
  "description": "Private local development snapshots with reviewed restore and Git commits.",
  "version": "0.2.5",
  "publisher": "dev-snapshot",
  "license": "MIT",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["SCM Providers", "Other"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "AmberTrail executes Git and restores local files only in trusted workspaces." },
    "virtualWorkspaces": { "supported": false, "description": "MVP requires a local filesystem and Git." }
  },
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "devSnapshot", "title": "AmberTrail", "icon": "media/snapshot.svg" }] },
    "views": { "devSnapshot": [{ "id": "devSnapshot.timeline", "name": "작업 기록", "type": "webview" }] },
    "commands": [
      { "command": "devSnapshot.agentHistorySettings", "title": "AmberTrail: Codex 연동 설정 및 기록 삭제" },
      { "command": "devSnapshot.agentReportDetails", "title": "AmberTrail: Codex 작업 설명 보기" },
      { "command": "devSnapshot.linkAgentReport", "title": "AmberTrail: Codex 설명과 기록 연결 검토" },
      { "command": "devSnapshot.openAgentSnapshots", "title": "AmberTrail: Codex 연결 기록 보기" },
      { "command": "devSnapshot.captureNow", "title": "AmberTrail: Capture Now", "icon": "$(add)" },
      { "command": "devSnapshot.refresh", "title": "AmberTrail: Refresh", "icon": "$(refresh)" },
      { "command": "devSnapshot.pauseRecording", "title": "AmberTrail: Pause Recording" },
      { "command": "devSnapshot.resumeRecording", "title": "AmberTrail: Resume Recording" },
      { "command": "devSnapshot.openDiff", "title": "AmberTrail: 스냅샷 변경 비교", "icon": "$(diff)" },
      { "command": "devSnapshot.restoreSnapshot", "title": "AmberTrail: 스냅샷 복원", "icon": "$(history)" },
      { "command": "devSnapshot.undoRestore", "title": "AmberTrail: Undo Last Restore" },
      { "command": "devSnapshot.prepareCommit", "title": "AmberTrail: 이 시점까지의 작업 커밋", "icon": "$(git-commit)" },
      { "command": "devSnapshot.toggleCommitFile", "title": "AmberTrail: 커밋 파일 포함/제외" },
      { "command": "devSnapshot.renameSnapshot", "title": "AmberTrail: 작업 이름 편집", "icon": "$(edit)" },
      { "command": "devSnapshot.deleteSnapshot", "title": "AmberTrail: 스냅샷 삭제", "icon": "$(trash)" },
      { "command": "devSnapshot.push", "title": "AmberTrail: Review and Push" },
      { "command": "devSnapshot.pinSnapshot", "title": "AmberTrail: Toggle Snapshot Pin", "icon": "$(pin)" },
      { "command": "devSnapshot.manageHistory", "title": "AmberTrail: Manage History" },
      { "command": "devSnapshot.recordingSettings", "title": "AmberTrail: 기록 주기 설정" },
      { "command": "devSnapshot.recover", "title": "AmberTrail: Review Recovery" }
    ],
    "configuration": {
      "title": "AmberTrail",
      "properties": {
        "devSnapshot.showAgentReports": { "type": "boolean", "default": false, "scope": "window", "description": "Show the optional legacy Codex reports and linking controls. Snapshot titles always use local change analysis unless manually named." },
        "devSnapshot.pythonPath": { "type": "string", "default": "", "scope": "application", "description": "Python 3.12+ executable dedicated to AmberTrail (for example a venv Python). Empty uses python on Windows or python3 on macOS/Linux. Reload the window after changing." },
        "devSnapshot.idleSeconds": { "type": "number", "default": 5, "minimum": 1, "maximum": 1000000, "scope": "resource", "description": "파일 변경이 멈춘 뒤 기록까지 기다리는 시간(초). 기본 5초. 관리 팝업에서는 5초 단위로 변경합니다." },
        "devSnapshot.maxIntervalSeconds": { "type": "number", "default": 60, "minimum": 5, "maximum": 1000000, "scope": "resource", "description": "연속 편집 중 최대 기록 대기 시간(초). 기본 60초(1분). 관리 팝업에서는 1분 단위로 변경합니다. 변경이 없으면 중복 기록하지 않습니다." },
        "devSnapshot.reconcileSeconds": { "type": "number", "default": 120, "minimum": 10, "scope": "resource", "description": "파일 감시에서 누락된 변경을 확인하는 보조 스캔 주기(초). 기본 120초. 전체 내용을 다시 해시하는 주기와 별개입니다." },
        "devSnapshot.fullHashSeconds": { "type": "number", "default": 600, "minimum": 30, "maximum": 1000000, "scope": "resource", "description": "관리 대상 파일을 다시 읽어 내용 해시를 확인하는 주기(초). 기본 600초(10분). 관리 팝업에서는 5분 단위로 변경합니다. 테스트 실행이나 저장된 전체 이력의 무결성 검사는 아닙니다." },
        "devSnapshot.maxFileMiB": { "type": "number", "default": 10, "minimum": 1, "maximum": 100, "scope": "resource" },
        "devSnapshot.retentionDays": { "type": "number", "default": 30, "minimum": 1, "scope": "resource" },
        "devSnapshot.maxSnapshots": { "type": "number", "default": 1000, "minimum": 2, "scope": "resource" },
        "devSnapshot.maxStorageMiB": { "type": "number", "default": 2048, "minimum": 10, "scope": "resource" },
        "devSnapshot.exclude": { "type": "array", "items": { "type": "string" }, "default": [], "scope": "resource", "description": "Additional excluded relative path globs." },
        "devSnapshot.allowSensitiveFiles": { "type": "array", "items": { "type": "string" }, "default": [], "scope": "application", "description": "Explicit sensitive filename/path globs to allow. User settings only. This never overrides Git ignores or additional exclusions." }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "compile:test": "tsc",
    "test": "npm run test:python && npm run test:bridge",
    "test:python": "node scripts/python.mjs backend/test_runner.py",
    "test:bridge": "npm run compile:test && node --test out/test/bridge.test.js out/test/extension.test.js",
    "test:integration": "npm run build && npm run compile:test && node out/test/runIntegration.js",
    "benchmark": "node scripts/python.mjs backend/benchmark.py",
    "package": "npm run build && vsce package --out ambertrail-0.2.5.vsix",
    "vscode:prepublish": "npm run check && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.5",
    "typescript": "5.8.3"
  },
  "repository": { "type": "git", "url": "https://github.com/Amber8800/Amberog.git" }
}
