{
  "name": "dev-snapshot",
  "displayName": "Amberog",
  "description": "Private local development snapshots with reviewed restore and Git commits.",
  "version": "0.1.1",
  "publisher": "dev-snapshot",
  "license": "MIT",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["SCM Providers", "Other"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Amberog executes Git and restores local files only in trusted workspaces." },
    "virtualWorkspaces": { "supported": false, "description": "MVP requires a local filesystem and Git." }
  },
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "devSnapshot", "title": "Amberog", "icon": "media/snapshot.svg" }] },
    "views": { "devSnapshot": [{ "id": "devSnapshot.timeline", "name": "Development history" }] },
    "commands": [
      { "command": "devSnapshot.captureNow", "title": "Amberog: Capture Now", "icon": "$(add)" },
      { "command": "devSnapshot.refresh", "title": "Amberog: Refresh", "icon": "$(refresh)" },
      { "command": "devSnapshot.pauseRecording", "title": "Amberog: Pause Recording" },
      { "command": "devSnapshot.resumeRecording", "title": "Amberog: Resume Recording" },
      { "command": "devSnapshot.openDiff", "title": "Amberog: Compare with Previous Snapshot", "icon": "$(diff)" },
      { "command": "devSnapshot.restoreSnapshot", "title": "Amberog: Restore Snapshot", "icon": "$(history)" },
      { "command": "devSnapshot.undoRestore", "title": "Amberog: Undo Last Restore" },
      { "command": "devSnapshot.prepareCommit", "title": "Amberog: Review Current Files for Commit" },
      { "command": "devSnapshot.push", "title": "Amberog: Review and Push" },
      { "command": "devSnapshot.pinSnapshot", "title": "Amberog: Toggle Snapshot Pin", "icon": "$(pin)" },
      { "command": "devSnapshot.manageHistory", "title": "Amberog: Manage History" },
      { "command": "devSnapshot.recover", "title": "Amberog: Review Recovery" }
    ],
    "menus": {
      "view/title": [
        { "command": "devSnapshot.captureNow", "when": "view == devSnapshot.timeline", "group": "navigation" },
        { "command": "devSnapshot.refresh", "when": "view == devSnapshot.timeline", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "devSnapshot.restoreSnapshot", "when": "view == devSnapshot.timeline && viewItem == snapshot", "group": "inline" },
        { "command": "devSnapshot.pinSnapshot", "when": "view == devSnapshot.timeline && viewItem == snapshot", "group": "inline" },
        { "command": "devSnapshot.prepareCommit", "when": "view == devSnapshot.timeline && viewItem == snapshot", "group": "review" }
      ]
    },
    "configuration": {
      "title": "Amberog",
      "properties": {
        "devSnapshot.pythonPath": { "type": "string", "default": "", "scope": "application", "description": "Python 3.12+ executable dedicated to Amberog (for example a venv Python). Empty uses python on Windows or python3 on macOS/Linux. Reload the window after changing." },
        "devSnapshot.idleSeconds": { "type": "number", "default": 5, "minimum": 1, "scope": "resource" },
        "devSnapshot.maxIntervalSeconds": { "type": "number", "default": 60, "minimum": 5, "scope": "resource" },
        "devSnapshot.reconcileSeconds": { "type": "number", "default": 120, "minimum": 10, "scope": "resource" },
        "devSnapshot.fullHashSeconds": { "type": "number", "default": 600, "minimum": 30, "scope": "resource" },
        "devSnapshot.maxFileMiB": { "type": "number", "default": 10, "minimum": 1, "maximum": 100, "scope": "resource" },
        "devSnapshot.retentionDays": { "type": "number", "default": 30, "minimum": 1, "scope": "resource" },
        "devSnapshot.maxSnapshots": { "type": "number", "default": 1000, "minimum": 2, "scope": "resource" },
        "devSnapshot.maxStorageMiB": { "type": "number", "default": 2048, "minimum": 10, "scope": "resource" },
        "devSnapshot.exclude": { "type": "array", "items": { "type": "string" }, "default": [], "scope": "resource", "description": "Additional excluded relative path globs." },
        "devSnapshot.allowSensitiveFiles": { "type": "array", "items": { "type": "string" }, "default": [], "scope": "application", "description": "Explicit sensitive filename/path globs to allow. User settings only. This never overrides Git ignores or additional exclusions." }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "compile:test": "tsc",
    "test": "npm run test:python && npm run test:bridge",
    "test:python": "node scripts/python.mjs backend/test_runner.py",
    "test:bridge": "npm run compile:test && node --test out/test/bridge.test.js",
    "test:integration": "npm run build && npm run compile:test && node out/test/runIntegration.js",
    "benchmark": "node scripts/python.mjs backend/benchmark.py",
    "package": "npm run build && vsce package --out amberog-0.1.1.vsix",
    "vscode:prepublish": "npm run check && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.5",
    "typescript": "5.8.3"
  },
  "repository": { "type": "git", "url": "https://github.com/Amber8800/Amberog.git" }
}
